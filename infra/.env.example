# Copy to infra/.env and adjust if needed. .env is gitignored.
BIND_ADDR=127.0.0.1
POSTGRES_PASSWORD=change-me-in-generated-env
# Public URLs you open in the browser (links in chat/emails). `office setup` fills these in.
# The office itself always uses 127.0.0.1. Extra LAN bindings live in docker-compose.lan.yml.
MM_SITE_URL=http://127.0.0.1:8065
FORGEJO_ROOT_URL=http://127.0.0.1:3033/
